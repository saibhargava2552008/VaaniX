# Copy this file to backend/.env and fill it in on your laptop.
# Never commit backend/.env or paste keys into chats, screenshots or logs.

# Safety switch. Keep false until the team approves real API calls.
ALLOW_REAL_API_CALLS=false

# mock | sarvam | gemini  (provider decision pending, keep mock)
LLM_PROVIDER=mock

# Sarvam: speech-to-text, text-to-speech, and optionally the LLM
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_LLM_MODEL=sarvam-105b-conversations

# Gemini: leave empty unless the 18+ terms question is resolved
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend addresses allowed to call the backend (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
